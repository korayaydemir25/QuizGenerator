<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>QuizGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- DB PostgreSQL için (Railway'de en yaygın kombinasyon). SQL Server kullanıyorsanız
         bu paketi Microsoft.EntityFrameworkCore.SqlServer ile değiştirin ve
         Program.cs + Data/AppDbContext.cs içindeki UseNpgsql çağrılarını UseSqlServer yapın. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
